local function CreateFlyPlatform()
    if flyPlatform and flyPlatform.Parent then return flyPlatform end
    local platform = Instance.new("Part")
    platform.Name = "FlyPlatform"
    platform.Size = Vector3.new(10, 1, 10)
    platform.Transparency = 1
    platform.Anchored = true
    platform.CanCollide = true
    platform.Parent = workspace
    flyPlatform = platform
    return platform
end

local function RemoveFlyPlatform()
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    if flyPlatform then
        flyPlatform:Destroy()
        flyPlatform = nil
    end
end

local function topos(targetCFrame)
    local char = player.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    
    if not rootPart then return end

    if currentTween then currentTween:Cancel() end
    if flyConnection then flyConnection:Disconnect() end

    local distance = (rootPart.Position - targetCFrame.Position).Magnitude
    local speed = (Settings and Settings.FlySpeed) or 300

    if distance > 10 then
        local platform = CreateFlyPlatform()
        local tweenInfo = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
        
        currentTween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
        
        flyConnection = RunService.Heartbeat:Connect(function()
            if rootPart and platform then
                rootPart.Velocity = Vector3.new(0, 0, 0)
                platform.CFrame = rootPart.CFrame * CFrame.new(0, -3.5, 0)
            else
                RemoveFlyPlatform()
            end
        end)

        currentTween.Completed:Connect(function()
            RemoveFlyPlatform()
        end)

        currentTween:Play()
    else
        rootPart.CFrame = targetCFrame
        RemoveFlyPlatform()
    end
end


