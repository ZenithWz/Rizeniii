local function GetWeaponByType(weaponType)
    local weapons = { Melee = {}, Sword = {}, Gun = {}, Fruit = {} }
    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local toolTip = tool.ToolTip
            if toolTip == "Combat" or toolTip == "Melee" then table.insert(weapons.Melee, tool.Name)
            elseif toolTip == "Sword" then table.insert(weapons.Sword, tool.Name)
            elseif toolTip == "Gun" then table.insert(weapons.Gun, tool.Name)
            elseif toolTip == "Blox Fruit" then table.insert(weapons.Fruit, tool.Name) end
        end
    end
    if player.Character then
        for _, tool in pairs(player.Character:GetChildren()) do
            if tool:IsA("Tool") then
                local toolTip = tool.ToolTip
                if toolTip == "Combat" or toolTip == "Melee" then table.insert(weapons.Melee, tool.Name)
                elseif toolTip == "Sword" then table.insert(weapons.Sword, tool.Name)
                elseif toolTip == "Gun" then table.insert(weapons.Gun, tool.Name)
                elseif toolTip == "Blox Fruit" then table.insert(weapons.Fruit, tool.Name) end
            end
        end
    end
    return weapons[weaponType][1]
end

